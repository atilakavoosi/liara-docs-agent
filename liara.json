{
  "platform": "next",
  "app": "liarayar",
  "port": 3000,
  "next": {
    "nodeVersion": "22"
  },
  "build": {
    "location": "germany"
  },
  "healthCheck": {
    "command": "curl -f http://127.0.0.1:3000/api/health || exit 1",
    "interval": 60,
    "timeout": 10,
    "retries": 3,
    "startPeriod": 30
  }
}
