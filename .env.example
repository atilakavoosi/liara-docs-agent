# ارائه‌دهنده‌ی هوش مصنوعی: AvalAI — سازگار با OpenAI (ADR-006)
BASE_URL=https://api.avalai.ir/v1

# کلید API از پنل AvalAI. فقط سمت سرور، هرگز با پیشوند NEXT_PUBLIC_.
AI_API_KEY=

# شناسه‌ی مدل‌ها روی AvalAI بدون پیشوند provider هستن (برخلاف سرویس
# خود لیارا که مدل‌ها رو با پیشوند openai/ یا google/ می‌ده).
MODEL_FAST=gpt-5.6-luna
MODEL_SMART=gpt-5.6-terra
MODEL_EMBED=text-embedding-3-small

# سقف‌های محافظتی
RATE_LIMIT_PER_MIN=12
MAX_TOKENS_PER_REQUEST=4000

# رمز ورود به /admin (داشبورد مصرف/هزینه). یک رشته‌ی تصادفی بلند بذار،
# چیزی حدس‌زدنی نه. اگه ست نشه، /admin کلاً غیرفعال می‌مونه (503).
ADMIN_TOKEN=

# اختیاری: قیمت واقعی هر مدل روی AvalAI، برای تخمین هزینه در /admin.
# تا وقتی این‌ها ست نشن، داشبورد به‌جای عدد ساختگی می‌گه «تنظیم نشده».
# اسم env بر اساس شناسه‌ی مدل ساخته می‌شه: حروف بزرگ، غیرالفبایی‌عددی → _
# مثال برای MODEL_SMART=gpt-5.6-terra:
# PRICE_GPT_5_6_TERRA_IN_PER_1M=
# PRICE_GPT_5_6_TERRA_OUT_PER_1M=
# PRICE_CURRENCY=تومان
